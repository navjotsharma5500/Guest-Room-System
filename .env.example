# Private server-to-server Venue Integration credential.
# Generate a unique high-entropy value for each environment; never commit a real key.
VENUE_API_KEY=<Secret Key>
# Separate server-only credential for final DoSA-approved Society Portal events.
# Must differ from VENUE_API_KEY and every VENUE_API_KEYS value. Never expose in frontend code.
VENUE_SOCIETY_PORTAL_WRITE_API_KEY=

# Optional rotation support. When set, provide comma-separated active keys.
# VENUE_API_KEYS=replace-with-current-secret,replace-with-next-secret
